FROM node:22.21.1-alpine3.22 AS build
WORKDIR /source

RUN npm install --global --ignore-scripts pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY src/frontend ./src/frontend
COPY eng/verify-frontend-boundaries.mjs ./eng/verify-frontend-boundaries.mjs
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @vtt/web build

FROM nginx:1.27.3-alpine3.20 AS runtime
COPY deploy/compose/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /source/src/frontend/apps/web/dist /usr/share/nginx/html

USER 101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
