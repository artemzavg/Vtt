# Local development only. Never reuse these values in shared or production environments.
COMPOSE_PROJECT_NAME=vtt
POSTGRES_SUPERUSER=vtt_admin
POSTGRES_SUPERUSER_PASSWORD=local-only-postgres
VTT_LOCAL_DB_PASSWORD=local-only-service-db
REDIS_PASSWORD=local-only-redis
MINIO_ROOT_USER=vtt_local_admin
MINIO_ROOT_PASSWORD=local-only-minio-password
GRAFANA_ADMIN_USER=vtt_local_admin
GRAFANA_ADMIN_PASSWORD=local-only-grafana-password

# Host ports are loopback-bound by Compose.
VTT_POSTGRES_PORT=55432
VTT_NATS_PORT=54222
VTT_NATS_MONITOR_PORT=58222
VTT_REDIS_PORT=56379
VTT_MINIO_PORT=59000
VTT_MINIO_CONSOLE_PORT=59001
VTT_WEB_PORT=55173

# App telemetry is optional; this endpoint is reachable from the Compose network.
VTT_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
