{
  "name": "vtt-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "pnpm --filter @vtt/api-client build && pnpm --filter @vtt/ui build && pnpm --filter @vtt/testing build && pnpm --filter @vtt/web build",
    "contracts:check": "node eng/verify-contracts.mjs",
    "contracts:generate": "node eng/generate-contracts.mjs",
    "dev": "pnpm --filter @vtt/web dev",
    "e2e": "playwright test",
    "format": "prettier --write eslint.config.js playwright.config.ts package.json pnpm-workspace.yaml \"eng/*.mjs\" \"src/frontend/**/*.{ts,tsx,js,mjs,json,css,yaml}\"",
    "format:check": "prettier --check eslint.config.js playwright.config.ts package.json pnpm-workspace.yaml \"eng/*.mjs\" \"src/frontend/**/*.{ts,tsx,js,mjs,json,css,yaml}\"",
    "lint": "eslint . --max-warnings=0 && node eng/verify-frontend-boundaries.mjs && pnpm contracts:check",
    "platform:benchmark": "node eng/benchmark-engineering.mjs",
    "security:scan": "node eng/verify-secrets.mjs",
    "test": "pnpm --filter @vtt/web test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "4.11.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.4",
    "vitest": "4.0.15"
  }
}
